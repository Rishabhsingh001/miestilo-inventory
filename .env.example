# Server-only environment variables. Never commit real secrets.
MONGODB_URI=mongodb+srv://REPLACE_WITH_LOCAL_OR_PREVIEW_CREDENTIALS
MONGODB_DB_NAME=misterio_inventory_dev

# Configure according to the chosen Auth.js/provider setup.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Optional file storage: configure only if image/document upload is implemented.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional monitoring
SENTRY_DSN=

# Application defaults
APP_NAME="Misterio Lifestyle Inventory"
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
